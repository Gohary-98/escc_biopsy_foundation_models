# Copy to `.env` and fill in. `.env` is gitignored.

# Root of the data tree. Defaults to <repo>/data. The clinical workbooks are
# expected at $EC_WSI_DATA_DIR/raw/clinical_data/ (definitive_clean.xlsx and
# neoadjuvant_clean.xlsx).
# EC_WSI_DATA_DIR=/path/to/data

# Where the whole-slide images live. Defaults to $EC_WSI_DATA_DIR/raw/histopathology.
# EC_WSI_SLIDE_DIR=/path/to/slides

# Hugging Face token, for the gated pathology foundation models used by TRIDENT.
# Request access first:
#   https://huggingface.co/MahmoodLab/UNI2-h
#   https://huggingface.co/MahmoodLab/conchv1_5
#   https://huggingface.co/MahmoodLab/TITAN
# HF_TOKEN=hf_...

# Only needed if the `openslide-bin` wheel fails and you install the OpenSlide
# Windows binaries by hand. Point at the directory containing the DLLs.
# OPENSLIDE_PATH=C:/opt/openslide/bin
